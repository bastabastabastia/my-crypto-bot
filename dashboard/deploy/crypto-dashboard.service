[Unit]
Description=Crypto Agent Dashboard (Flask via gunicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/dashboard
EnvironmentFile=/root/dashboard/.env
ExecStart=/root/dashboard/.venv/bin/gunicorn \
    --bind 0.0.0.0:5000 \
    --workers 2 \
    --access-logfile /root/dashboard.access.log \
    --error-logfile /root/dashboard.error.log \
    app:app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
